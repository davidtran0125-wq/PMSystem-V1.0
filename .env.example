# ---------------------------------------------------------------------------
# Database (used by docker-compose and the API)
# ---------------------------------------------------------------------------
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms_password
POSTGRES_DB=pms
POSTGRES_PORT=5432
DATABASE_URL="postgresql://pms:pms_password@localhost:5432/pms?schema=public"

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Riêng các endpoint đăng nhập / đăng ký. Nới lên nếu cả văn phòng đi chung
# một IP ra ngoài, vì giới hạn tính theo IP.
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=60

# ---------------------------------------------------------------------------
# S3 compatible storage (MinIO in local dev)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pms
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PORT=9000
S3_CONSOLE_PORT=9001
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

# ---------------------------------------------------------------------------
# Mail (notifications). Leave SMTP_HOST empty to log emails instead of sending.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PMS <no-reply@pms.local>"

# ---------------------------------------------------------------------------
# Seed admin account
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@pms.local
SEED_ADMIN_PASSWORD=Admin@123

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# Trợ lý AI (Phase 3). Bỏ trống thì các tính năng AI bị tắt và báo lỗi rõ ràng.
# Lấy key tại https://platform.claude.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
