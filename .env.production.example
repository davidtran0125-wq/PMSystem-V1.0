# Biến môi trường cho pmsystem.io.vn.
#
#   cp .env.production.example .env.production
#
# Sinh ba khóa bí mật bằng: openssl rand -base64 48
# KHÔNG commit .env.production lên git.

# ---------------------------------------------------------------------------
# Database — chỉ container trong cùng mạng nối được, không mở ra internet
# ---------------------------------------------------------------------------
POSTGRES_USER=pms
POSTGRES_PASSWORD=            # đổi thành mật khẩu dài, ngẫu nhiên
POSTGRES_DB=pms
# DATABASE_URL do docker-compose.prod.yml tự ghép từ ba biến trên.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=production
API_PORT=4000
API_PREFIX=api

# Đúng hai tên miền này, không có dấu / ở cuối, không dùng dấu *.
CORS_ORIGIN=https://pmsystem.io.vn,https://www.pmsystem.io.vn

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token KHÔNG phải JWT: nó là chuỗi ngẫu nhiên 48 byte, chỉ lưu bản băm
# SHA-256 trong database, và xoay vòng mỗi lần dùng. Vì vậy không có
# JWT_REFRESH_SECRET — biến đó nằm trong .env.example nhưng code không đọc tới.
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL=60
THROTTLE_LIMIT=120
# Cả văn phòng thường đi chung một IP ra ngoài, mà giới hạn tính theo IP.
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=60

# Swagger phơi bày toàn bộ hình dạng API. Để trống nghĩa là tắt ở production.
SWAGGER_ENABLED=

# ---------------------------------------------------------------------------
# Lưu file đính kèm
# ---------------------------------------------------------------------------
# Hiện chỉ có driver lưu trên ổ đĩa. Các biến S3_* trong .env.example là chỗ
# dành sẵn, StorageService chưa đọc tới — đừng trông chờ chúng có tác dụng.
#
# Đường dẫn này phải nằm trong volume `storage` khai báo ở docker-compose.prod.yml.
# Trỏ ra ngoài volume là mỗi lần deploy lại mất sạch file đã tải lên.
LOCAL_STORAGE_PATH=/app/storage

# ---------------------------------------------------------------------------
# Email thông báo. Bỏ trống SMTP_HOST thì hệ thống chỉ ghi log thay vì gửi thật.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PMS <no-reply@pmsystem.io.vn>"

# ---------------------------------------------------------------------------
# Tài khoản quản trị đầu tiên. Đổi mật khẩu ngay sau lần đăng nhập đầu.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@pmsystem.io.vn
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Trợ lý AI. Bỏ trống thì các tính năng AI tắt và báo lỗi rõ ràng.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
