{
  "name": "pms",
  "version": "1.0.0",
  "private": true,
  "description": "Procurement Management System — purchase requests, RFQ, quotations, suppliers and contracts",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:api": "npm run start:dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/api && npm run build --prefix apps/web",
    "install:all": "npm install --prefix apps/api && npm install --prefix apps/web",
    "db:migrate": "npm run db:migrate --prefix apps/api",
    "db:deploy": "npm run db:deploy --prefix apps/api",
    "db:seed": "npm run db:seed --prefix apps/api",
    "db:studio": "npm run db:studio --prefix apps/api",
    "smoke-test": "node scripts/smoke-test.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "features-test": "node scripts/features-test.mjs",
    "materials-test": "node scripts/materials-test.mjs",
    "users-test": "node scripts/users-test.mjs",
    "test:all": "npm run smoke-test && npm run users-test && npm run materials-test && npm run features-test && npm run orders-test && npm run status-test",
    "orders-test": "node scripts/orders-test.mjs",
    "status-test": "node scripts/status-counts-test.mjs",
    "perf-bench": "node scripts/perf-bench.mjs",
    "demo-clip": "node scripts/demo-clip.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
